{
  "name": "ipfspawn",
  "version": "0.2.1-rc.0",
  "private": false,
  "description": "Thin unscoped CLI entry delegating to @silvermoon-work/ipfspawn.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/ipfspawn.git"
  },
  "homepage": "https://github.com/silvermoon-work/ipfspawn#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/ipfspawn/issues"
  },
  "bin": {
    "ipfspawn": "./dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.12",
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check": "pnpm format-check && pnpm build && pnpm typecheck && pnpm lint && pnpm test-coverage && pnpm lint-package",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint-package": "publint --strict",
    "prepublishOnly": "publish-gate check",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@silvermoon-work/ipfspawn": "0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@silvermoon-work/devtool.publish-gate": "0.1.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "rimraf": "6.1.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
